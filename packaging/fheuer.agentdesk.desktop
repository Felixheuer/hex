[Desktop Entry]
Type=Application
Name=Agent-Desk
Comment=Local voice dictation
Exec=@AGENT_DESK_BIN@
Icon=fheuer.agentdesk
Terminal=false
Categories=Utility;Accessibility;
StartupNotify=true
StartupWMClass=fheuer.agentdesk
Actions=quit;

[Desktop Action quit]
Name=Quit Agent-Desk
Exec=@AGENT_DESK_BIN@ quit
