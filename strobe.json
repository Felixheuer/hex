{
  "$schema": "https://raw.githubusercontent.com/anomalyco/strobe/main/schema/strobe.v1.json",
  "build": {
    "command": "cargo build --locked --release --bin agent-desk",
    "output": {
      "windows": "{cache}/cargo-target/release/agent-desk.exe",
      "macos": "{cache}/cargo-target/release/agent-desk",
      "linux": "{cache}/cargo-target/release/agent-desk"
    },
    "env": {
      "CARGO_TARGET_DIR": "{cache}/cargo-target",
      "CARGO_PROFILE_RELEASE_DEBUG": "line-tables-only",
      "CARGO_PROFILE_RELEASE_STRIP": "false",
      "CARGO_PROFILE_RELEASE_INCREMENTAL": "false",
      "TRANSCRIBE_CMAKE_ARGS": "-DGGML_NATIVE=OFF"
    },
    "windows": {
      "env": { "RUSTUP_TOOLCHAIN": "stable-x86_64-pc-windows-msvc" }
    }
  },
  "apps": {
    "hex": {
      "kind": "native",
      "exe": {
        "windows": "target/release/agent-desk.exe",
        "macos": "/Applications/Agent-Desk.app/Contents/MacOS/agent-desk",
        "linux": "~/.local/share/agent-desk/current/hex"
      },
      "args": ["app"],
      "env": {
        "AGENT_DESK_APPLICATION_SUPPORT_DIR": "{home}/hex-data",
        "AGENT_DESK_DISABLE_UPDATES": "1",
        "HF_HUB_CACHE": "{home}/.cache/huggingface/hub"
      },
      "unset": ["AGENT_DESK_*", "WGPU_*", "RUNE_*", "HF_HOME", "RUST_LOG"],
      "moved": ["~/Library/Application Support/agent-desk"],
      "files": {
        "hex-data/onboarding-complete": "",
        "hex-data/settings.json": {
          "enable_on_launch": false,
          "history_retention": "forever",
          "migrations": ["scrawl-capture-settings", "scrawl-routing-settings", "anomaly-hex-identity"]
        }
      },
      "guard": [
        { "os": "windows", "file": "%APPDATA%/hex/local-api.json", "pid": "pid" },
        { "os": "windows", "file": "%APPDATA%/hex/settings.json" },
        { "os": "macos", "file": "~/Library/Application Support/agent-desk/local-api.json", "pid": "pid" },
        { "os": "macos", "file": "~/Library/Application Support/agent-desk/settings.json" },
        { "os": "linux", "file": "~/.local/share/agent-desk/local-api.json", "pid": "pid" },
        { "os": "linux", "file": "~/.local/share/agent-desk/settings.json" }
      ]
    },
    "hex-listening": {
      "extends": "hex",
      "files": {
        "hex-data/settings.json": {
          "enable_on_launch": true,
          "release_microphone_while_idle": true,
          "dictation_hotkey": { "keys": [{ "code": 80, "label": "F19" }] },
          "paste_last_hotkey": null,
          "capture": { "enabled": true, "hotkey": { "keys": [{ "code": 79, "label": "F18" }] } },
          "history_retention": "forever",
          "migrations": ["scrawl-capture-settings", "scrawl-routing-settings", "annotate-on-by-default", "anomaly-hex-identity"]
        }
      }
    },
    "hex-listening-warm": {
      "extends": "hex",
      "files": {
        "hex-data/settings.json": {
          "enable_on_launch": true,
          "release_microphone_while_idle": false,
          "dictation_hotkey": { "keys": [{ "code": 80, "label": "F19" }] },
          "paste_last_hotkey": null,
          "capture": { "enabled": true, "hotkey": { "keys": [{ "code": 79, "label": "F18" }] } },
          "history_retention": "forever",
          "migrations": ["scrawl-capture-settings", "scrawl-routing-settings", "annotate-on-by-default", "anomaly-hex-identity"]
        }
      }
    },
    "hex-dictation": {
      "extends": "hex",
      "env": { "AGENT_DESK_AUDIO_FIXTURE": "{home}/speech.wav" },
      "files": {
        "hex-data/settings.json": {
          "enable_on_launch": true,
          "release_microphone_while_idle": false,
          "sound_effects": false,
          "show_dock_icon": false,
          "dictation_hotkey": { "keys": [{ "code": 80, "label": "F19" }] },
          "paste_last_hotkey": null,
          "capture": { "enabled": true, "hotkey": { "keys": [{ "code": 79, "label": "F18" }] } },
          "history_retention": "forever",
          "migrations": ["scrawl-capture-settings", "scrawl-routing-settings", "annotate-on-by-default", "anomaly-hex-identity"]
        }
      }
    },
    "hex-dictation-released": {
      "extends": "hex-dictation",
      "files": {
        "hex-data/settings.json": {
          "enable_on_launch": true,
          "release_microphone_while_idle": true,
          "sound_effects": false,
          "show_dock_icon": false,
          "dictation_hotkey": { "keys": [{ "code": 80, "label": "F19" }] },
          "paste_last_hotkey": null,
          "capture": { "enabled": true, "hotkey": { "keys": [{ "code": 79, "label": "F18" }] } },
          "history_retention": "forever",
          "migrations": ["scrawl-capture-settings", "scrawl-routing-settings", "annotate-on-by-default", "anomaly-hex-identity"]
        }
      }
    }
  },
  "benches": ["perf/**/*.bench.ts"],
  "metrics": { "equivalence": "2%" }
}
